# Shared database connection
DATABASE_URL=mysql+pymysql://mini_erp:YOUR_MYSQL_PASSWORD@127.0.0.1:3306/mini_erp?charset=utf8mb4
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FLASK_DEBUG=1
PORT=5000

# Inventory login (change these values before starting the service)
INVENTORY_USERNAME=inventory
INVENTORY_PASSWORD=change-this-password
INVENTORY_SECRET_KEY=replace-with-a-long-random-secret
# Optional: use a Werkzeug password hash instead of INVENTORY_PASSWORD.
# INVENTORY_PASSWORD_HASH=
